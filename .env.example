# Telegram Bot Credentials
# Get your bot token from @BotFather on Telegram (100% Free)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Get your Chat ID from @userinfobot or @raw_data_bot on Telegram
# Can be your personal Chat ID or a Channel ID (e.g. -1001234567890)
TELEGRAM_CHAT_ID=1234567890

# Optional: Separate channel IDs if you want each game sent to a different channel for each FB Page
# If left unset, all videos are sent to TELEGRAM_CHAT_ID above.
TELEGRAM_CHAT_ID_PAGE1=
TELEGRAM_CHAT_ID_PAGE2=
TELEGRAM_CHAT_ID_PAGE3=
